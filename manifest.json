{
  "manifest_version": 3,
  "name": "AutoFill Pro — اپلای هوشمند",
  "version": "7.1.1",
  "description": "AI-powered job application tool: autofill, cover letters, job tracker, search, Gmail, referrals",
  "update_url": "https://arefmtl.github.io/autofill-pro/updates.xml",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/sidebar.js"],
      "css": [],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": [],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/gmail-integration.js"],
      "css": [],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://lever.co/*",
        "https://*.lever.co/*",
        "https://workday.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://ashbyhq.com/*",
        "https://*.ashbyhq.com/*",
        "https://smartrecruiters.com/*",
        "https://*.smartrecruiters.com/*",
        "https://icims.com/*",
        "https://*.icims.com/*",
        "https://taleo.net/*",
        "https://*.taleo.net/*",
        "https://workable.com/*",
        "https://*.workable.com/*",
        "https://stepstone.de/*",
        "https://*.stepstone.de/*",
        "https://xing.com/*",
        "https://*.xing.com/*",
        "https://indeed.com/*",
        "https://*.indeed.com/*",
        "https://glassdoor.com/*",
        "https://*.glassdoor.com/*",
        "https://monster.de/*",
        "https://*.monster.de/*",
        "https://arbeitsagentur.de/*",
        "https://*.arbeitsagentur.de/*"
      ],
      "js": ["content/referral-finder.js"],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "background/ai.js", "logo.png", "utils/crypto.js", "popup/tracker.html", "popup/retouch.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://indeed.com/*",
    "https://*.indeed.com/*",
    "https://stepstone.de/*",
    "https://*.stepstone.de/*",
    "https://xing.com/*",
    "https://*.xing.com/*",
    "https://glassdoor.com/*",
    "https://*.glassdoor.com/*",
    "https://monster.de/*",
    "https://*.monster.de/*",
    "https://arbeitsagentur.de/*",
    "https://*.arbeitsagentur.de/*",
    "https://mail.google.com/*",
    "https://greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "https://lever.co/*",
    "https://*.lever.co/*",
    "https://workday.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://ashbyhq.com/*",
    "https://*.ashbyhq.com/*",
    "https://smartrecruiters.com/*",
    "https://*.smartrecruiters.com/*"
  ]
}
