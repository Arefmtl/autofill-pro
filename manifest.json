{
  "manifest_version": 3,
  "name": "AutoFill Pro — اپلای هوشمند",
  "version": "8.2.0",
  "description": "Smart job application assistant: auto-detect jobs, match score, Gmail sync, autofill",
  "update_url": "https://arefmtl.github.io/autofill-pro/updates.xml",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "identity",
    "notifications"
  ],
  "host_permissions": [
    "https://api.opencode.ai/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/sidebar.js", "content/job-detector.js"],
      "css": [],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content/referral-finder.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["content/gmail-integration.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "background/ai.js", "logo.png", "utils/crypto.js", "popup/tracker.html", "popup/retouch.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
